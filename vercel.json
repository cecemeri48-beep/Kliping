{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/buku/:id",
      "destination": "/api/perpustakaan?book=:id"
    },
    {
      "source": "/sampul/:id",
      "destination": "/api/perpustakaan?cover=:id"
    },
    {
      "source": "/klip/:id",
      "destination": "/api/share?id=:id"
    },
    {
      "source": "/rss.xml",
      "destination": "/api/feed?jenis=rss"
    },
    {
      "source": "/feed",
      "destination": "/api/feed?jenis=rss"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/feed?jenis=sitemap"
    }
  ],
  "functions": {
    "api/perpustakaan.js": {
      "includeFiles": "perpustakaan.html",
      "maxDuration": 30
    }
  }
}